#!/usr/bin/env just --justfile

# Intermediate CA Operations
# Online CA for day-to-day certificate issuance

set shell := ["bash", "-euo", "pipefail"]

CA_DIR := justfile_directory()
PRIVATE_DIR := CA_DIR + "/private"
CERTS_DIR := CA_DIR + "/certs"
CSR_DIR := CA_DIR + "/csr"
NEWCERTS_DIR := CA_DIR + "/newcerts"
OPENSSL_CONF := CA_DIR + "/openssl.cnf"

# Retrieve passphrase from pass utility
get-passphrase:
    @pass show ca/intermediate-passphrase 2>/dev/null || echo ""

# Show available intermediate CA recipes
help:
    @just --list

# Initialize intermediate CA (create databases)
setup:
    #!/bin/bash
    set -euo pipefail
    mkdir -p "{{ PRIVATE_DIR }}" "{{ CERTS_DIR }}" "{{ CSR_DIR }}" "{{ NEWCERTS_DIR }}"

    if [[ ! -f "{{ CA_DIR }}/index.txt" ]]; then
        touch "{{ CA_DIR }}/index.txt"
    fi
    if [[ ! -f "{{ CA_DIR }}/serial" ]]; then
        echo 1000 > "{{ CA_DIR }}/serial"
    fi

    echo "✓ Intermediate CA initialized"

# Generate intermediate CA private key
gen-key algorithm="ed25519":
    #!/bin/bash
    set -euo pipefail
    mkdir -p "{{ PRIVATE_DIR }}"
    KEY_FILE="{{ PRIVATE_DIR }}/intermediate-ca.key"

    if [[ -f "$KEY_FILE" ]]; then
        echo "⚠️  Key already exists: $KEY_FILE"
        exit 1
    fi

    # Create encrypted key with passphrase from pass
    PASSPHRASE=$(pass show ca/intermediate-passphrase 2>/dev/null)
    if [[ -z "$PASSPHRASE" ]]; then
        echo "❌ Passphrase not found in pass utility"
        echo "Set it with: pass insert ca/intermediate-passphrase"
        exit 1
    fi

    case "{{ algorithm }}" in
        ed25519)
            echo "🔐 Generating Ed25519 private key (encrypted)..."
            openssl genpkey -algorithm ED25519 -aes-256-cbc \
              -pass pass:"$PASSPHRASE" -out "$KEY_FILE"
            chmod 400 "$KEY_FILE"
            echo "✓ Encrypted key generated: $KEY_FILE"
            ;;
        rsa)
            echo "🔐 Generating RSA-4096 private key (encrypted, may take a moment)..."
            openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 \
              -aes-256-cbc -pass pass:"$PASSPHRASE" -out "$KEY_FILE"
            chmod 400 "$KEY_FILE"
            echo "✓ Encrypted key generated: $KEY_FILE"
            ;;
        *)
            echo "❌ Unknown algorithm: {{ algorithm }}"
            exit 1
            ;;
    esac

# RSA key generation (convenience alias)
gen-key-rsa bits="4096":
    #!/bin/bash
    set -euo pipefail
    mkdir -p "{{ PRIVATE_DIR }}"
    KEY_FILE="{{ PRIVATE_DIR }}/intermediate-ca.key"

    if [[ -f "$KEY_FILE" ]]; then
        echo "⚠️  Key already exists: $KEY_FILE"
        exit 1
    fi

    PASSPHRASE=$(pass show ca/intermediate-passphrase 2>/dev/null)
    if [[ -z "$PASSPHRASE" ]]; then
        echo "❌ Passphrase not found in pass utility"
        exit 1
    fi

    echo "🔐 Generating RSA-{{ bits }} private key (encrypted, may take a moment)..."
    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:{{ bits }} \
      -aes-256-cbc -pass pass:"$PASSPHRASE" -out "$KEY_FILE"
    chmod 400 "$KEY_FILE"
    echo "✓ Encrypted key generated: $KEY_FILE"

# Generate CSR for intermediate CA
gen-csr:
    #!/bin/bash
    set -euo pipefail
    mkdir -p "{{ CSR_DIR }}"

    KEY_FILE="{{ PRIVATE_DIR }}/intermediate-ca.key"
    CSR_FILE="{{ CSR_DIR }}/intermediate-ca.csr"

    if [[ ! -f "$KEY_FILE" ]]; then
        echo "❌ Key not found: $KEY_FILE"
        echo "Run: just intermediate-gen-key"
        exit 1
    fi

    if [[ -f "$CSR_FILE" ]]; then
        echo "⚠️  CSR already exists: $CSR_FILE"
        exit 1
    fi

    PASSPHRASE=$(pass show ca/intermediate-passphrase 2>/dev/null)

    echo "📝 Generating intermediate CA CSR..."
    openssl req -new -key "$KEY_FILE" \
      -passin pass:"$PASSPHRASE" \
      -out "$CSR_FILE" -config "{{ OPENSSL_CONF }}"

    echo "✓ CSR generated: $CSR_FILE"
    echo "⚠️  NEXT STEP: Transfer this CSR to the root CA for signing"
    echo "   File: $CSR_FILE"

# Install signed intermediate certificate
install-cert cert-file:
    #!/bin/bash
    set -euo pipefail

    if [[ ! -f "{{ cert-file }}" ]]; then
        echo "❌ Certificate file not found: {{ cert-file }}"
        exit 1
    fi

    CERT_OUT="{{ CERTS_DIR }}/intermediate-ca.crt"

    if [[ -f "$CERT_OUT" ]]; then
        echo "⚠️  Certificate already installed: $CERT_OUT"
        exit 1
    fi

    echo "📥 Installing signed intermediate certificate..."
    cp "{{ cert-file }}" "$CERT_OUT"
    chmod 444 "$CERT_OUT"

    echo "✓ Certificate installed: $CERT_OUT"
    openssl x509 -in "$CERT_OUT" -noout -subject

# Generate CSR for end-entity certificate
gen-end-entity-csr cn st="Stockholm" c="SE" org="Organization" ou="IT":
    #!/bin/bash
    set -euo pipefail
    mkdir -p "{{ CSR_DIR }}"

    CSR_FILE="{{ CSR_DIR }}/{{ cn }}.csr"
    KEY_FILE="{{ CSR_DIR }}/{{ cn }}.key"

    if [[ -f "$CSR_FILE" ]]; then
        echo "⚠️  CSR already exists: $CSR_FILE"
        exit 1
    fi

    echo "🔐 Generating end-entity key and CSR for: {{ cn }}"

    # Generate private key
    openssl genpkey -algorithm ED25519 -out "$KEY_FILE"
    chmod 400 "$KEY_FILE"

    # Generate CSR
    openssl req -new -key "$KEY_FILE" -out "$CSR_FILE" \
      -subj "/C={{ c }}/ST={{ st }}/O={{ org }}/OU={{ ou }}/CN={{ cn }}"

    echo "✓ Key generated: $KEY_FILE"
    echo "✓ CSR generated: $CSR_FILE"

# Issue certificate from CSR
issue-cert csr-file:
    #!/bin/bash
    set -euo pipefail

    if [[ ! -f "{{ csr-file }}" ]]; then
        echo "❌ CSR file not found: {{ csr-file }}"
        exit 1
    fi

    KEY_FILE="{{ PRIVATE_DIR }}/intermediate-ca.key"
    if [[ ! -f "$KEY_FILE" ]]; then
        echo "❌ CA key not found: $KEY_FILE"
        exit 1
    fi

    CERT_NAME=$(basename "{{ csr-file }}" .csr)
    CERT_OUT="{{ NEWCERTS_DIR }}/${CERT_NAME}.crt"

    if [[ -f "$CERT_OUT" ]]; then
        echo "⚠️  Certificate already exists: $CERT_OUT"
        exit 1
    fi

    PASSPHRASE=$(pass show ca/intermediate-passphrase 2>/dev/null)

    echo "✍️  Issuing certificate..."
    echo "  CSR: {{ csr-file }}"
    echo "  Output: $CERT_OUT"

    openssl ca -config "{{ OPENSSL_CONF }}" \
      -extensions v3_end_entity \
      -days 365 \
      -notext -md sha256 \
      -passin pass:"$PASSPHRASE" \
      -in "{{ csr-file }}" \
      -out "$CERT_OUT" \
      -batch

    echo "✓ Certificate issued: $CERT_OUT"

# Revoke a certificate
revoke cert-file reason="unspecified":
    #!/bin/bash
    set -euo pipefail

    if [[ ! -f "{{ cert-file }}" ]]; then
        echo "❌ Certificate file not found: {{ cert-file }}"
        exit 1
    fi

    KEY_FILE="{{ PRIVATE_DIR }}/intermediate-ca.key"
    PASSPHRASE=$(pass show ca/intermediate-passphrase 2>/dev/null)

    echo "⚠️  Revoking certificate: {{ cert-file }}"
    echo "   Reason: {{ reason }}"

    openssl ca -config "{{ OPENSSL_CONF }}" \
      -revoke "{{ cert-file }}" \
      -passin pass:"$PASSPHRASE" \
      -batch

    echo "✓ Certificate revoked"

# Generate Certificate Revocation List
gen-crl:
    #!/bin/bash
    set -euo pipefail
    mkdir -p "{{ CA_DIR }}/crl"

    CRL_FILE="{{ CA_DIR }}/crl/intermediate-ca.crl"
    KEY_FILE="{{ PRIVATE_DIR }}/intermediate-ca.key"
    PASSPHRASE=$(pass show ca/intermediate-passphrase 2>/dev/null)

    echo "📋 Generating Certificate Revocation List..."

    openssl ca -config "{{ OPENSSL_CONF }}" \
      -gencrl \
      -passin pass:"$PASSPHRASE" \
      -out "$CRL_FILE"

    echo "✓ CRL generated: $CRL_FILE"

# View intermediate CA certificate
inspect:
    #!/bin/bash
    set -euo pipefail

    CERT_FILE="{{ CERTS_DIR }}/intermediate-ca.crt"

    if [[ ! -f "$CERT_FILE" ]]; then
        echo "❌ Certificate not found: $CERT_FILE"
        exit 1
    fi

    echo "📋 Intermediate CA Certificate Details:"
    openssl x509 -in "$CERT_FILE" -text -noout

# Show intermediate CA status
status:
    #!/bin/bash
    set -euo pipefail
    echo "🔍 Intermediate CA Status"
    echo "========================="

    KEY_FILE="{{ PRIVATE_DIR }}/intermediate-ca.key"
    CERT_FILE="{{ CERTS_DIR }}/intermediate-ca.crt"

    if [[ -f "$KEY_FILE" ]]; then
        echo "✓ Private key exists: $KEY_FILE"
    else
        echo "✗ Private key NOT found"
    fi

    if [[ -f "$CERT_FILE" ]]; then
        echo "✓ Certificate exists: $CERT_FILE"
        VALID_UNTIL=$(openssl x509 -in "$CERT_FILE" -noout -enddate | cut -d= -f2)
        echo "  Valid until: $VALID_UNTIL"
    else
        echo "✗ Certificate NOT found"
    fi

    if [[ -f "{{ CA_DIR }}/index.txt" ]]; then
        CERT_COUNT=$(grep -c "^V" "{{ CA_DIR }}/index.txt" 2>/dev/null || echo 0)
        echo "✓ Issued certificates: $CERT_COUNT"
    fi
